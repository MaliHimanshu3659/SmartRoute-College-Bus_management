# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=change_to_a_secure_random_string_in_production
QR_EXPIRATION_SECONDS=60

# Database Connection (Option A: Cloud Database URI)
# DATABASE_URL=mysql://username:password@hostname:3306/dbname

# Database Connection (Option B: Individual MySQL Parameters)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smartroute
MYSQL_SSL=false
